shm_unit_test
+TRANS_DELAY_MIN=64
+TRANS_DELAY_MAX=128
+TRANS_NUM=16
+EXTERNAL_BUSY_PERCENT=10
+TEST_DRAIN_TIMEOUT_CYCLES=5000
endargs

v2m_unit_test: shm_unit_test
+CREQ_RW=SHM_V2M
endargs

m2v_unit_test: shm_unit_test
+CREQ_RW=SHM_M2V
endargs

v2m_vtrans_test: shm_unit_test
+VTRANS_EN=100
endargs

